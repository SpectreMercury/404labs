  "description": "Stable per-project localhost port assignment for AI-built apps. Prevents 3000/3001 drift, checks occupancy, and ships as an agent skill plus CLI.",
  "bin": {
    "portguard": "./bin/cli.js",
    "pgport": "./bin/cli.js"
  },
